# ElevenLabs API Key (Required for real-time transcription via Scribe v2 Realtime)
# Get your API key at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Gladia API Key (Required for simultaneous comparison with Gladia Live v2 / Solaria-1)
# Can also be entered directly in the top configuration bar of the UI
# Get your API key at: https://app.gladia.io/
GLADIA_API_KEY=your_gladia_api_key_here

# Backend proxy server port (default: 3001)
PORT=3001

# ElevenLabs Realtime Speech-to-Text WebSocket endpoint (optional override)
# Options:
#   Global (default): wss://api.elevenlabs.io/v1/speech-to-text/realtime
#   US Residency:     wss://api.us.elevenlabs.io/v1/speech-to-text/realtime
#   EU Residency:     wss://api.eu.residency.elevenlabs.io/v1/speech-to-text/realtime
ELEVENLABS_WS_URL=wss://api.elevenlabs.io/v1/speech-to-text/realtime

# Gladia V2 Live session endpoint (optional override)
GLADIA_LIVE_URL=https://api.gladia.io/v2/live?region=eu-west

# Google Cloud Speech-to-Text v2 (chirp_3) Configuration
# Paste the Service Account JSON on a single line in GOOGLE_CREDENTIALS_JSON
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"your_google_project_id_here","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"stt-client@your_google_project_id_here.iam.gserviceaccount.com"}
GOOGLE_CLOUD_PROJECT=your_google_project_id_here
GOOGLE_STT_LOCATION=eu
GOOGLE_STT_MODEL=chirp_3


